# Django secret key
SECRET_KEY=your-secret-key

# Debug mode (True for local development, False for production)
DEBUG=True

# Allowed hosts (comma-separated in production)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database settings (default uses SQLite, optional for PostgreSQL)
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# JWT settings
ACCESS_TOKEN_LIFETIME=5m
REFRESH_TOKEN_LIFETIME=1d
